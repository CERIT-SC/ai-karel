#!/usr/bin/env python3
"""Scriptable fake kubectl for collector tests, driven by a scenario file.

  FAKE_KUBECTL_SCENARIO=/path/scenario.json
      {"calls": [{"argv_contains": ["get","pods","gpu-operator"],
                  "stdout": "...", "stdout_file": "relative/or/abs/path",
                  "stderr": "", "rc": 0}]}
  FAKE_KUBECTL_CALLS=/path/calls.jsonl   (every invocation recorded here, one
                                           argv JSON list per line)

The first call entry whose argv_contains strings ALL appear in the joined
argv wins. Default answer is an empty `{"items": []}`. Exit codes and stderr
simulate denials and timeouts without a cluster.
"""

import json
import os
import sys

def main():
    scenario_path = os.environ.get("FAKE_KUBECTL_SCENARIO")
    argv = sys.argv[1:]
    joined = " ".join(argv)

    calls_log = os.environ.get("FAKE_KUBECTL_CALLS")
    if calls_log:
        with open(calls_log, "a") as fh:
            fh.write(json.dumps(argv) + "\n")

    scenario = {}
    if scenario_path and os.path.exists(scenario_path):
        with open(scenario_path) as fh:
            scenario = json.load(fh)

    matched = [c for c in scenario.get("calls", [])
               if all(w in joined for w in (c.get("argv_contains") or []))]
    # Most specific entry wins: ["logs","fleet-agent-0"] must beat
    # ["cattle-fleet-system"] for a `kubectl logs ... -n cattle-fleet-system`
    # invocation, or every log fetch would be answered with the pods list.
    matched.sort(key=lambda c: -len(c.get("argv_contains") or []))
    if matched:
        c = matched[0]
        if c.get("stdout_file"):
            base = os.path.dirname(os.path.abspath(scenario_path))
            path = c["stdout_file"]
            if not os.path.isabs(path):
                path = os.path.join(base, path)
            with open(path, errors="replace") as fh:
                sys.stdout.write(fh.read())
        else:
            sys.stdout.write(c.get("stdout") or "")
        sys.stderr.write(c.get("stderr") or "")
        sys.exit(int(c.get("rc", 0)))

    sys.stdout.write('{"items": []}')
    sys.exit(0)


if __name__ == "__main__":
    main()
