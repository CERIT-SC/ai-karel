{
  "_comment": "Karel Kubernetes collector manifest. Executed by run-plan.sh. Tier 1 = degraded-mode evidence (must survive a broken cluster), tier 2 = normal, tier 3 = bulk. expected_status lets a known-denied resource not be reported as a fault. expect_json:false marks commands that return plain text. ${KAREL_HOME} in argv is replaced with the image root by run.sh, so the same manifest works in the image and from a checkout.",
  "commands": [
    { "name": "k_version",        "argv": ["kubectl","version","-o","json"],                                   "tier": 1, "timeout": 20 },
    { "name": "k_readyz",         "argv": ["kubectl","get","--raw","/readyz?verbose"],                          "tier": 1, "timeout": 20, "expect_json": false },
    { "name": "k_livez",          "argv": ["kubectl","get","--raw","/livez?verbose"],                           "tier": 1, "timeout": 20, "expect_json": false },
    { "name": "k_nodes",          "argv": ["kubectl","get","nodes","-o","json"],                                "tier": 1, "timeout": 30 },

    { "name": "k_pods",           "argv": ["kubectl","get","pods","-A","-o","json"],                            "tier": 2, "timeout": 90 },
    { "name": "k_replicasets",    "argv": ["kubectl","get","replicasets","-A","-o","json"],                     "tier": 2, "timeout": 60 },
    { "name": "k_deployments",    "argv": ["kubectl","get","deployments","-A","-o","json"],                     "tier": 2, "timeout": 45 },
    { "name": "k_statefulsets",   "argv": ["kubectl","get","statefulsets","-A","-o","json"],                    "tier": 2, "timeout": 45 },
    { "name": "k_daemonsets",     "argv": ["kubectl","get","daemonsets","-A","-o","json"],                      "tier": 2, "timeout": 45 },
    { "name": "k_jobs",           "argv": ["kubectl","get","jobs","-A","-o","json"],                            "tier": 2, "timeout": 45 },
    { "name": "k_cronjobs",       "argv": ["kubectl","get","cronjobs","-A","-o","json"],                        "tier": 2, "timeout": 45 },
    { "name": "k_pvc",            "argv": ["kubectl","get","pvc","-A","-o","json"],                             "tier": 2, "timeout": 45 },
    { "name": "k_pv",             "argv": ["kubectl","get","pv","-o","json"],                                   "tier": 2, "timeout": 45 },
    { "name": "k_storageclass",   "argv": ["kubectl","get","storageclass","-o","json"],                         "tier": 2, "timeout": 30 },
    { "name": "k_volumeattach",   "argv": ["kubectl","get","volumeattachments","-o","json"],                    "tier": 2, "timeout": 45 },
    { "name": "k_csidrivers",     "argv": ["kubectl","get","csidrivers","-o","json"],                           "tier": 2, "timeout": 30 },
    { "name": "k_csinodes",       "argv": ["kubectl","get","csinodes","-o","json"],                             "tier": 2, "timeout": 30 },
    { "name": "k_pdb",            "argv": ["kubectl","get","poddisruptionbudgets","-A","-o","json"],            "tier": 2, "timeout": 30 },
    { "name": "k_validatingwh",   "argv": ["kubectl","get","validatingwebhookconfigurations","-o","json"],      "tier": 2, "timeout": 30 },
    { "name": "k_mutatingwh",     "argv": ["kubectl","get","mutatingwebhookconfigurations","-o","json"],        "tier": 2, "timeout": 30 },
    { "name": "k_endpointslices", "argv": ["kubectl","get","endpointslices","-A","-o","json"],                  "tier": 2, "timeout": 60 },
    { "name": "k_services",       "argv": ["kubectl","get","services","-A","-o","json"],                        "tier": 2, "timeout": 45 },
    { "name": "k_apiservices",    "argv": ["kubectl","get","apiservices","-o","json"],                          "tier": 2, "timeout": 30 },
    { "name": "k_crds",           "argv": ["kubectl","get","crds","-o","json"],                                 "tier": 3, "timeout": 60 },
    { "name": "k_namespaces",     "argv": ["kubectl","get","namespaces","-o","json"],                           "tier": 2, "timeout": 30 },
    { "name": "k_resourcequota",  "argv": ["kubectl","get","resourcequota","-A","-o","json"],                   "tier": 2, "timeout": 30 },
    { "name": "k_leases",         "argv": ["kubectl","get","leases","-A","-o","json"],                          "tier": 2, "timeout": 45 },
    { "name": "k_events",         "argv": ["python3","${KAREL_HOME}/bin/collect_events.py","--once"],           "tier": 2, "timeout": 90 },
    { "name": "k_ingresses",      "argv": ["kubectl","get","ingresses","-A","-o","json"],                       "tier": 2, "timeout": 45 },
    { "name": "k_hpa",            "argv": ["kubectl","get","hpa","-A","-o","json"],                             "tier": 2, "timeout": 45 },
    { "name": "k_clusterpolicy",  "argv": ["kubectl","get","clusterpolicies.nvidia.com","-o","json"],           "tier": 2, "timeout": 30, "expected_status": "eacces" },
    { "name": "k_etcd_snapshots", "argv": ["kubectl","get","etcdsnapshotfiles.k3s.cattle.io","-A","-o","json"], "tier": 2, "timeout": 30, "expected_status": "eacces" },
    { "name": "k_acme_solvers",   "argv": ["kubectl","get","pods","-A","-l","acme.cert-manager.io/http01-solver=true","-o","json"], "tier": 2, "timeout": 45 },
    { "name": "k_acme_challenges","argv": ["kubectl","get","challenges.acme.cert-manager.io","-A","-o","json"], "tier": 2, "timeout": 45, "expected_status": "eacces" },
    { "name": "k_acme_certificates","argv": ["kubectl","get","certificates.cert-manager.io","-A","-o","json"],  "tier": 2, "timeout": 45, "expected_status": "eacces" },
    { "name": "k_acme_probe",     "argv": ["python3","${KAREL_HOME}/bin/probe_acme.py"],                        "tier": 2, "timeout": 60 },
    { "name": "k_networkpolicies","argv": ["kubectl","get","networkpolicies","-A","-o","json"],                 "tier": 2, "timeout": 45 },
    { "name": "k_resourceslices", "argv": ["kubectl","get","resourceslices.resource.k8s.io","-A","-o","json"],    "tier": 2, "timeout": 45, "expected_status": "eacces" },
    { "name": "k_gateways",       "argv": ["kubectl","get","gateways.gateway.networking.k8s.io","-A","-o","json"], "tier": 2, "timeout": 45, "expected_status": "eacces" },
    { "name": "k_httproutes",     "argv": ["kubectl","get","httproutes.gateway.networking.k8s.io","-A","-o","json"], "tier": 2, "timeout": 45, "expected_status": "eacces" },
    { "name": "k_cnpg_clusters",  "argv": ["kubectl","get","clusters.postgresql.cnpg.io","-A","-o","json"],       "tier": 2, "timeout": 30, "expected_status": "eacces" },
    { "name": "k_log_thanos_sidecar",   "argv": ["python3","${KAREL_HOME}/bin/collect_logs.py","--check","thanos_sidecar"],   "tier": 2, "timeout": 60 },
    { "name": "k_log_thanos_compactor", "argv": ["python3","${KAREL_HOME}/bin/collect_logs.py","--check","thanos_compactor"], "tier": 2, "timeout": 60 },
    { "name": "k_log_thanos_querier",   "argv": ["python3","${KAREL_HOME}/bin/collect_logs.py","--check","thanos_querier"],   "tier": 2, "timeout": 60 },
    { "name": "k_log_fleet_agent",      "argv": ["python3","${KAREL_HOME}/bin/collect_logs.py","--check","fleet_agent"],      "tier": 2, "timeout": 60 },
    { "name": "k_log_gpu_crash",        "argv": ["python3","${KAREL_HOME}/bin/collect_logs.py","--check","gpu_crash"],        "tier": 2, "timeout": 60 },
    { "name": "k_log_nvupdater",        "argv": ["python3","${KAREL_HOME}/bin/collect_logs.py","--check","gpu_nvupdater"],    "tier": 2, "timeout": 60 },
    { "name": "k_helmcharts",     "argv": ["kubectl","get","helmcharts.helm.cattle.io","-A","-o","json"],       "tier": 2, "timeout": 30 },
    { "name": "k_helmchartcfg",   "argv": ["kubectl","get","helmchartconfigs.helm.cattle.io","-A","-o","json"], "tier": 2, "timeout": 30 },
    { "name": "k_csr",            "argv": ["kubectl","get","certificatesigningrequests","-o","json"],           "tier": 2, "timeout": 30 },

    { "name": "k_top_cpu",        "argv": ["python3","${KAREL_HOME}/bin/collect_usage.py","cpu"],               "tier": 9, "timeout": 1200 },
    { "name": "k_top_gpu",        "argv": ["python3","${KAREL_HOME}/bin/collect_usage.py","gpu"],               "tier": 9, "timeout": 600 },
    { "name": "k_jupyter_notebooks", "argv": ["python3","${KAREL_HOME}/bin/collect_jupyter.py"],                "tier": 9, "timeout": 300 },

    { "name": "k_top_nodes",      "argv": ["kubectl","top","nodes","--no-headers"],                             "tier": 2, "timeout": 30, "expect_json": false },
    { "name": "k_apiserver_metrics", "argv": ["python3","${KAREL_HOME}/bin/apiserver_metrics.py"],                 "tier": 2, "timeout": 60 },
    { "name": "k_tls_probe",      "argv": ["python3","${KAREL_HOME}/bin/probe_tls.py"],                            "tier": 2, "timeout": 30 },
    { "name": "k_event_buffer",   "argv": ["python3","${KAREL_HOME}/bin/fetch_event_buffer.py"],                   "tier": 2, "timeout": 30 }
  ]
}
